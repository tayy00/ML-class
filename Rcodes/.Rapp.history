library(igraph)#
rm(list = ls())#
analysisfolder <- '~/Dropbox/Ali/Research/integHBP/Analysis/'#
###
## read the network info and integrative scores#
###
#
## read enrichment scores#
analysisdate <- '042115'#
pathranktbl <- read.csv(paste(analysisfolder, 'pathRankDetails',analysisdate,'.csv', sep=''))#
#
## read the inforamtion about the nodes (degrees and number of significant neighbors)#
netinfo <- read.csv(paste(analysisfolder, 'PathNet_directed.csv', sep=''))#
nodeinfo <- read.csv(paste(analysisfolder, 'NodeInfo4Enrichment.csv', sep=''))#
#degrees <- nodeinfo[,3]		#these are dir deg, for net permutation, need undir deg (below)#
nnode <- nrow(nodeinfo)#
#
edgelist <- netinfo[,c(2,4)]						#read the path names#
net <- graph.data.frame(edgelist,directed=FALSE)	#create an undirected network (all paths)#
net <- simplify(net)								#remove double edges and loops#
deg1 <- degree(net)#
net <- induced.subgraph(net,as.character(nodeinfo[,2]))	#take the subset of connected nodes#
deg2 <- degree(net)#
##find indeces of top5 in the list of nodes.#
indx <- (nodeinfo[,4] > 0)		#top 5 pathways#
top5indx <- c(1:nnode)[indx]		#indices of top 5 pathways#
top5.ids <- as.character(nodeinfo[indx,1])#
top5.names <- as.character(nodeinfo[indx,2])#
#
top5.deg <- deg2[names(deg2) %in% top5.names]#
indx <- match(top5.names,names(top5.deg))#
top5.deg <- top5.deg[indx]#
top5.info <- data.frame(top5.ids, top5.names, top5.deg, rep(0,5))#
  names(top5.info) <- c('pathID','pathName','degree','nnbrintop10')#
##add no of sig neighbors of top5 pathways, based on observed data#
for(j in 1:5){#
	nbrs <- neighbors(net,v=which(names(deg2)==top5.names[j]),mode=3)#
	nbrs <- names(deg2)[nbrs]#
	indx <- which(as.character(nodeinfo[,2]) %in% nbrs)#
	top5.info$nnbrintop10[j] <- sum(nodeinfo[indx,5])#
}#
## find no of sig neighbors of top5 pathways in simulated networks#
niter <- 10000#
ntop10 <- matrix(0, niter, 5)#
colnames(ntop10) <- as.character(top5.names)#
#
## reorder the degrees to match the node info #
indx <- match(nodeinfo[,2], names(deg2))#
#sum(names(deg2)[indx] != nodeinfo[,2])#
## network permutation test#
set.seed(22)#
for (i in 1:niter){#
	##generate a network with the same degree distribution#
	g <- degree.sequence.game(out.deg=deg2[indx], method = "vl")#
	##for each of top5, find the number of sig nodes in the sim graph#
	for (j in 1:5){#
		nghbrs <- neighbors(g, (top5indx[j]) )#
		ntop10[i,j] <- sum(nodeinfo[nghbrs,5])#
	}#
}#
## calculate p-values#
pvals <- matrix(top5.info[,4], nrow=niter, ncol=5, byrow=T)#
pvals <- (ntop10 >= pvals)#
pvals <- apply(pvals, 2, mean)#
top5.info <- data.frame(top5.info, pvals)#
#
## reorder the p-values and degrees of top 5 to match the order of the scores#
## The node info file is in the order (p.C,p.V,p.A,p.R,p.B) --> need (p.R,p.B,p.A,p.V,p.C)#
indx <- c(4,5,3,2,1)#
pvals <- pvals[indx]#
#top5.deg <- top5.deg[indx]#
#top5.names <- top5.names[indx]#
top5.info <- top5.info[indx,]#
#
###
## plot the degree distribution and overlay the permutation p-values#
###
pdf(paste(analysisfolder,'degdistwsig_',analysisdate,'.pdf',sep=''), height=6, width=10)#
#
par(mar=c(4.5,4.5,4.5,10), las=2)#
h <- hist(deg2, breaks=8, xlab="Node Degree", #
	main="Pathway Network Degree Distribution", freq=FALSE, ylim=c(0,0.15))#
#
par(new = TRUE)#
y1 <- -log10(1)#
y2 <- -log10(signif(min(pvals),1))#
#
plot(x=pvals, y=-log10(pvals), type='n', #
	axes=F, xlab='', ylab='', xlim=c(0,18.5), ylim=c(y1,y2))#
#
mycols <- c('orange','green','red','blue','purple')#
#
for(j in 1:5){#
	arrows(x0=jitter(top5.info$degree[j],factor=3),y0=-log10(top5.info$pvals[j]),#
		y1=y1, col=mycols[j], lwd=3)#
}#
#
axislbls <- seq(y1,signif(y2,1),length.out=5)#
axis(side=4, at=axislbls, labels=paste('-log(',signif(10^(-axislbls),1),')',sep=''))#
mtext("-log10(p)", side=4, line=5)#
legend('topright',as.character(top5.info$pathName),bty='n',lty=1,lwd=3,col=mycols)#
#
dev.off()#
###
## plot the integrative scores, as well as permutation p-values#
###
topscores <- pathranktbl[1:5,10]#
integscore <- pathranktbl[,10]#
#
pdf(paste(analysisfolder,'integscore_permpval_',analysisdate,'.pdf',sep=''), width=8,height=5)#
#
par(las=1, mar=c(4,4,3,6))#
y4bp = boxplot(integscore, main="Integrative Score", horizontal=T,#
	boxwex=0.4, xlab='Score', xlim=c(0.7,3.5), pch=15,#
	log='x', col='gray', ylab='-log10(P(net perm))')#
axis(side=4, at=axislbls+1, labels=paste('-log(',signif(10^(-axislbls),1),')',sep=''))#
#
for(i in 1:5){#
  arrows(x0=topscores[i],y0=-log10(top5.info$pvals[i])+1.01,y1=1.01, #
	col=mycols[i], lwd=2, length=0.2)#
}#
#legend('bottomright', mypaths, lty=1, lwd=2, col=mycolors, bty='n')#
legend('topleft', as.character(top5.info$pathName), lty=1, lwd=2, col=mycols, bty='n')#
#
dev.off()#
###
## compare integrative rankings with individual rankings for top 10 pathways#
###
indx <- c(1:dim(pathranktbl)[1])#
top5.b <- (indx <= 5)#
top10.b <- (indx <= 10)#
top5.g <- (rank(pathranktbl$GSArank.avg.g) <= 5)#
top5.m <- (rank(pathranktbl$NetGSArank.avg.m) <= 5)#
#
top5.b <- pathranktbl[top5.b, c(2,5,6)]#
top10.b <- pathranktbl[top10.b, c(2,5,6)]#
top5.g <- pathranktbl[top5.g, c(2,5,6)]#
top5.m <- pathranktbl[top5.m, c(2,5,6)]#
#
tmp <- (indx > 5)#
tmp <- pathranktbl[tmp,]#
top10.g.nottop5.b <- (rank(tmp$GSArank.avg.g) <= 10)#
top10.g.nottop5.b <- tmp[top10.g.nottop5.b, c(2,5,6)]#
#
toplot <- t(as.matrix(top10.b[, c(2,3)]))#
	colnames(toplot) <- as.character(top10.b[,1])#
	rownames(toplot) <- c('rank.m', 'rank.g')#
#
##to match with score rankings#
toplot <- toplot[,c(1,2,3,5,4,6,7,8,9,10)]#
#
pdf(paste(analysisfolder,'rankcomp_top10_',analysisdate,'.pdf',sep=''))#
#par(mar = c(4,15,1,1))#
dotchart(toplot, pch=c(20,8), col=c(2,4), gcolor='black', xlab='gene/metab rank')#
mtext('integrative rank', side=2, line=2)#
abline(v=5, lwd=2)#
dev.off()
myx <- top5.info$degree
myx
