train.err.10=numeric(10)#
for (i in 1:10){#
 glm.fit=glm(y~poly(bmi,i),data=dat)#
 cv.error.10[i]=cv.glm(dat,glm.fit,K=10)$delta[1]#
 train.err.10[i]=mean(glm.fit$residuals^2)#
 }#
cv.error.10
