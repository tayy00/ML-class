y1 <- -log10(1)#
y2 <- -log10(signif(min(pvals),1))#
#
plot(x=pvals, y=-log10(pvals), type='n', #
	axes=F, xlab='', ylab='', xlim=c(0,18.5), ylim=c(y1,y2))#
#
mycols <- c('orange','green','red','blue','purple')#
#
## change the x-location for arrows for those with same x#
myx <- top5.info$degree; myx[4]<-myx[4]-0.2; myx[5]<-myx[5]+0.2#
#
for(j in 1:5){#
	arrows(x0=myx,y0=-log10(top5.info$pvals[j]),#
		y1=y1, col=mycols[j], lwd=3)#
}#
#
